# Supabase Configuration
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_for_server_only

# Backend API Configuration
VITE_API_URL=http://localhost:3001/api

# Lovart OpenAPI Configuration (server only; never prefix with VITE_)
LOVART_ACCESS_KEY=your_lovart_access_key
LOVART_SECRET_KEY=your_lovart_secret_key
LOVART_BASE_URL=https://lgw.lovart.ai
LOVART_PROJECT_ID=optional_existing_lovart_project_id

# Cloudflare R2 Configuration
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_BUCKET=mist-school-assets
R2_PUBLIC_URL=https://your_public_r2_domain
VITE_R2_PUBLIC_URL=https://your_public_r2_domain
